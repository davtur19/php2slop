[global]
pid = RUNDIR/php-fpm.pid
error_log = LOGDIR/fpm-error.log
log_level = notice
daemonize = yes
process_control_timeout = 10

[mage]
user = davide
group = davide
listen = RUNDIR/php-fpm.sock
listen.mode = 0660
pm = static
pm.max_children = 1
pm.max_requests = 0
catch_workers_output = yes
access.log = LOGDIR/fpm-access.log
access.format = "%p|%d|%t|%m|%s"
php_admin_value[error_log] = LOGDIR/php-error.log
php_admin_flag[log_errors] = on
php_admin_flag[display_errors] = off
php_admin_value[error_reporting] = 32767
php_value[memory_limit] = 512M
php_value[post_max_size] = 8M
php_value[upload_max_filesize] = 8M
php_value[max_execution_time] = 120
php_value[max_input_time] = 120
php_value[default_socket_timeout] = 60
