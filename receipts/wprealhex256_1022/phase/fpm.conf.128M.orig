[global]
pid = /tmp/opencode/research/wprealhex_20261022T011837Z/run/php-fpm.pid
error_log = /tmp/opencode/research/wprealhex_20261022T011837Z/log/fpm-error.log
log_level = notice
daemonize = yes
process_control_timeout = 10

[wp]
user = davide
group = davide
listen = /tmp/opencode/research/wprealhex_20261022T011837Z/run/php-fpm.sock
listen.mode = 0660
pm = static
pm.max_children = 1
pm.max_requests = 0
pm.status_path = /fpm-status
catch_workers_output = yes
access.log = /tmp/opencode/research/wprealhex_20261022T011837Z/log/fpm-access.log
access.format = "%p|%d|%t|%m|%s"
php_admin_value[error_log] = /tmp/opencode/research/wprealhex_20261022T011837Z/log/php-error.log
php_admin_flag[log_errors] = on
php_admin_flag[display_errors] = off
php_admin_value[error_reporting] = 32767
php_admin_value[memory_limit] = 128M
php_admin_value[post_max_size] = 8M
php_admin_value[upload_max_filesize] = 8M
php_admin_value[max_file_uploads] = 20
php_admin_value[max_execution_time] = 120
php_admin_value[max_input_time] = 120
php_admin_value[default_socket_timeout] = 60
php_admin_value[session.save_handler] = files
php_admin_value[session.save_path] = /tmp/opencode/research/wprealhex_20261022T011837Z/sessions
php_admin_value[session.serialize_handler] = php
php_admin_value[session.use_strict_mode] = 0
php_admin_value[session.upload_progress.enabled] = 1
php_admin_value[session.upload_progress.cleanup] = 0
php_admin_value[session.upload_progress.freq] = 1
php_admin_value[session.upload_progress.min_freq] = 0
