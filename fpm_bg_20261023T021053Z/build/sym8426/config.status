  AWK="nawk" /bin/bash /tmp/opencode/php-8.4.26/build/genif.sh     /tmp/opencode/php-8.4.26/main/internal_functions.c.in     " date;ext/date pcre;ext/pcre ctype;ext/ctype filter;ext/filter hash;ext/hash json;ext/json posix;ext/posix random;ext/random reflection;ext/reflection session;ext/session spl;ext/spl standard;ext/standard tokenizer;ext/tokenizer" > main/internal_functions.c


