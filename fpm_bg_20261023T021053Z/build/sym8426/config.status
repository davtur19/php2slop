ac_pwd='/tmp/opencode/research/fpm_bg_20261023T021053Z/build/sym8426'
srcdir='/tmp/opencode/php-8.4.26'
test -n "$AWK" || AWK=awk
# The default lists apply if the user does not specify any file.
