Zend/zend_language_scanner.lo: /tmp/opencode/php-8.4.26/Zend/zend_language_parser.h
Zend/zend_ini_scanner.lo: /tmp/opencode/php-8.4.26/Zend/zend_ini_parser.h

/tmp/opencode/php-8.4.26/Zend/zend_language_scanner.c /tmp/opencode/php-8.4.26/Zend/zend_language_scanner_defs.h: /tmp/opencode/php-8.4.26/Zend/zend_language_scanner.l
	@(cd $(top_srcdir); $(RE2C) $(RE2C_FLAGS) --case-inverted -cbdFt Zend/zend_language_scanner_defs.h -oZend/zend_language_scanner.c Zend/zend_language_scanner.l)

/tmp/opencode/php-8.4.26/Zend/zend_language_parser.h: /tmp/opencode/php-8.4.26/Zend/zend_language_parser.c
/tmp/opencode/php-8.4.26/Zend/zend_language_parser.c: /tmp/opencode/php-8.4.26/Zend/zend_language_parser.y
# Tweak zendparse to be exported through ZEND_API. This has to be revisited once
# bison supports foreign skeletons and that bison version is used. Read
# https://git.savannah.gnu.org/cgit/bison.git/tree/data/README.md for more.
	@$(YACC) $(YFLAGS) -v -d /tmp/opencode/php-8.4.26/Zend/zend_language_parser.y -o $@
	@$(SED) -e 's,^int zendparse\(.*\),ZEND_API int zendparse\1,g' < $@ \
	> $@.tmp && \
	mv $@.tmp $@
	@$(SED) -e 's,^int zendparse\(.*\),ZEND_API int zendparse\1,g' < /tmp/opencode/php-8.4.26/Zend/zend_language_parser.h \
	> /tmp/opencode/php-8.4.26/Zend/zend_language_parser.h.tmp && \
	mv /tmp/opencode/php-8.4.26/Zend/zend_language_parser.h.tmp /tmp/opencode/php-8.4.26/Zend/zend_language_parser.h

/tmp/opencode/php-8.4.26/Zend/zend_ini_parser.h: /tmp/opencode/php-8.4.26/Zend/zend_ini_parser.c
/tmp/opencode/php-8.4.26/Zend/zend_ini_parser.c: /tmp/opencode/php-8.4.26/Zend/zend_ini_parser.y
	@$(YACC) $(YFLAGS) -v -d /tmp/opencode/php-8.4.26/Zend/zend_ini_parser.y -o $@

/tmp/opencode/php-8.4.26/Zend/zend_ini_scanner.c: /tmp/opencode/php-8.4.26/Zend/zend_ini_scanner.l
	@(cd $(top_srcdir); $(RE2C) $(RE2C_FLAGS) --case-inverted -cbdFt Zend/zend_ini_scanner_defs.h -oZend/zend_ini_scanner.c Zend/zend_ini_scanner.l)

# Use an intermediate target to indicate that zend_vm_gen.php produces both files
# at the same time, rather than the same recipe applying for two different targets.
# The "grouped targets" feature, which would solve this directly, is only available
# since GNU Make 4.3.
/tmp/opencode/php-8.4.26/Zend/zend_vm_execute.h /tmp/opencode/php-8.4.26/Zend/zend_vm_opcodes.c: vm.gen.intermediate ;
.INTERMEDIATE: vm.gen.intermediate
vm.gen.intermediate: /tmp/opencode/php-8.4.26/Zend/zend_vm_def.h /tmp/opencode/php-8.4.26/Zend/zend_vm_execute.skl /tmp/opencode/php-8.4.26/Zend/zend_vm_gen.php
	@if test ! -z "$(PHP)"; then \
		$(PHP) /tmp/opencode/php-8.4.26/Zend/zend_vm_gen.php; \
	fi;

Zend/zend_highlight.lo Zend/zend_compile.lo: /tmp/opencode/php-8.4.26/Zend/zend_language_parser.h

Zend/zend_execute.lo: /tmp/opencode/php-8.4.26/Zend/zend_vm_execute.h /tmp/opencode/php-8.4.26/Zend/zend_vm_opcodes.h
